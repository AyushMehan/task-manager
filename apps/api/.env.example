# Local dev points at the Postgres in docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://taskmanager:taskmanager@localhost:5433/taskmanager?schema=public"

PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Browser origins allowed to call this API.
CORS_ORIGINS="http://localhost:3000"

# Single-user mode: every task is owned by this account until JWT auth lands.
# The seed script creates it if missing.
DEFAULT_USER_EMAIL="mehan.ayush16@gmail.com"
DEFAULT_USER_NAME="Ayush"
